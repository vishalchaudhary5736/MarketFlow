NODE_ENV=development

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=60000
REDIS_USERNAME=default
REDIS_PASSWORD=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_service_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_service_db


JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CART_SERVICE_PORT=3002
CATALOG_SERVICE_PORT=3003
INVENTORY_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
ORDER_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008
BY_PASS_EMAIL_VERIFICATION=true
