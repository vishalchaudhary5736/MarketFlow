//npx prisma generate 
//npx prisma migrate dev --name update_user_fields

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique @db.VarChar(255)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  isEmailVerified     Boolean    @map("is_email_verified") @default(false)
  phone               String?    @unique @db.VarChar(15)
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  firstName           String     @map("first_name") @db.VarChar(100)
  lastName            String?    @map("last_name") @db.VarChar(100)
  avatarUrl           String?    @map("avatar_url")
  role                UserRole   @default(CUSTOMER)
  status              UserStatus @default(INACTIVE)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(3)
}



